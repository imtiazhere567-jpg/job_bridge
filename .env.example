# ---- Database ----
# Supabase connection string (Project Settings → Database → Connection string → "Transaction pooler", port 6543).
# Leave empty locally to use the built-in database in ./data.
DATABASE_URL=

# ---- Mode ----
# Demo mode (default): sample JobBridge jobs and applicants, one-click owner login,
# nothing sent to real phones, nightly reset.
# Set to "off" to go live (only the owner account and business are created).
DEMO_MODE=on
# Protects /api/cron (Vercel Cron sends it automatically). Any long random string.
CRON_SECRET=
# Optional public address for links in messages. On Vercel the project URL is used automatically.
APP_URL=

# ---- Live mode: the one owner login (set before the first start; the demo password is public) ----
OWNER_NAME=
OWNER_EMAIL=
OWNER_PASSWORD=

# ---- Claude (optional): job posts, CV reading and scoring ----
ANTHROPIC_API_KEY=

# ---- WhatsApp Cloud API (live mode) ----
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Approved template with one body variable {{1}}, used for messages that start a conversation
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en
# Webhook for applicant replies: <site>/api/whatsapp/webhook
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# ---- Email via Resend (live mode) ----
RESEND_API_KEY=
EMAIL_FROM=
